<?xml version='1.0' encoding='utf-8'?>
<widget id="com.kataloginventaris.rumah" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>Katalog Inventaris</name>
  <description>Katalog barang berharga di rumah dengan foto, nomor seri, dan pengelompokan ruangan.</description>
  <author email="developer@example.com" href="https://cordova.apache.org">Katalog Inventaris</author>
  <content src="index.html" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="mailto:*" />
  <preference name="AndroidXEnabled" value="true" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="SplashScreenDelay" value="0" />
  <plugin name="cordova-plugin-camera" spec="^8.0.0" />
  <plugin name="cordova-plugin-file" spec="^8.1.3" />
</widget>
